{
  "database": {
    "host": "localhost",
    "port": 3306,
    "user": "username",
    "password": "password",
    "database": "dbname",
    "table": "tablename",
    "id_column": "id"
  },
  "interval_seconds": 60,
  "parsing_rules": [
    {
      "column": "column_a",
      "type": "decimal",
      "precision": 2
    }
  ],
  "branch_rules": [
    {
      "column": "column_a",
      "value": "X",
      "folder": "folder/x"
    }
  ],
  "actions": [
    {
      "type": "api",
      "url": "https://api.example.com/endpoint",
      "method": "POST",
      "headers": {}
    },
    {
      "type": "file",
      "path": "output/data.txt",
      "format": "json"
    },
    {
      "type": "ftp",
      "host": "ftp.example.com",
      "port": 21,
      "user": "ftpuser",
      "password": "ftppass",
      "use_tls": true,
      "remote_path": "/uploads/",
      "filename_template": "data_{timestamp}.txt"
    }
  ],
  "output_format": {
    "structure": "custom",
    "template": "{column_a}|{column_b}|{column_c}"
  }
}
