{
  "database": {
    "host": "localhost",
    "port": 3306,
    "user": "username",
    "password": "password",
    "database": "dbname",
    "table": "tablename",
    "id_column": "id",
    "query": "SELECT a.id, a.name, a.price, b.platform_name FROM tablename a LEFT JOIN platforms b ON a.platform_id = b.id WHERE a.id > %s ORDER BY a.id ASC LIMIT 1000"
  },
  "interval_seconds": 60,
  "parsing_rules": [
    {"column": "price", "type": "decimal", "precision": 2},
    {"column": "name", "type": "string", "format": "{value}"},
    {"column": "created_at", "type": "date", "input_format": "%Y-%m-%d %H:%M:%S", "output_format": "%Y/%m/%d %H:%M"},
    {"column": "status", "type": "string", "format": "{:>10}"}
  ],
  "branch_rules": [
    {"column": "category", "value": "A", "folder": "category_a"}
  ],
  "actions": [
    {"type": "file", "path": "output/data.txt", "format": "structured", "structure": {"columns": ["name", "price"], "separator": ","}},
    {"type": "file", "path": "output/{id}.txt", "format": "structured", "structure": {"columns": ["name", "price", "platform_name"], "separator": ","}},
    {"type": "file", "path": "output/custom.txt", "format": "custom", "structure": {"template": "{name}|{price}|{created_at}", "separator": "|"}}
  ],
  "output_format": {"structure": "custom", "template": "{name},{price}"}
}
